{
  "name": "@patch/desktop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.renderer.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "package:win": "node scripts/package-win.mjs"
  },
  "dependencies": {
    "@google/genai": "2.17.0",
    "@patch/ai-core": "workspace:*",
    "@patch/logging": "workspace:*",
    "@patch/patch-dsl": "workspace:*",
    "@patch/persistence": "workspace:*",
    "@patch/protocol": "workspace:*",
    "@patch/provider-gemini": "workspace:*",
    "@patch/provider-openai": "workspace:*",
    "@patch/schemas": "workspace:*",
    "@patch/security": "workspace:*",
    "@patch/shared": "workspace:*",
    "@patch/tool-registry": "workspace:*",
    "better-sqlite3": "13.0.3",
    "framer-motion": "13.1.0",
    "openai": "7.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "description": "PATCH — the adaptive AI layer for your computer",
  "author": "PATCH Project",
  "packageManager": "pnpm@11.21.0"
}
